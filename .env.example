# Supabase (ct-web-lead-agent). Secret key is server-only — never prefix with NEXT_PUBLIC_.
# See docs/supabase-setup.md. Dashboard: https://supabase.com/dashboard/project/ytbdtfzdgncdupqzniba
SUPABASE_URL=https://ytbdtfzdgncdupqzniba.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ytbdtfzdgncdupqzniba.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated operator emails. Role is stored in app_metadata, not user_metadata.
OPERATOR_EMAILS=operator@example.com

# file = local JSON store for development. supabase = production.
DATA_DRIVER=file
DATA_FILE=data/local-store.json

# Local login when DATA_DRIVER=file. Never enable this in production.
ALLOW_DEV_AUTH=true
DEV_AUTH_SECRET=replace-me

# Worker + Add website paste enrich (optional on Vercel web)
PAGESPEED_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PLAYWRIGHT_ENABLED=false

# Google Places API (New) — used by POST /api/discovery/scan and /discover
# Enable "Places API (New)" in Google Cloud and restrict the key to that API.
GOOGLE_PLACES_API_KEY=
# Optional override for budget accounting (default 0.04)
# DISCOVERY_COST_USD_PER_REQUEST=0.04

# Budgets (USD). Enforced before paid calls.
MONTHLY_API_CAP_USD=50
DAILY_API_CAP_USD=5
AI_QUALITY_THRESHOLD=70
REAUDIT_DAYS=90
SITE_DRAFT_DIR=data/drafts

# Auto-publish generated sites (GitHub repo + Vercel + production checks).
# After score → site.generate → site.publish: private GitHub repo, Vercel deploy, live smoke tests.
AUTO_PUBLISH_SITES=true
SITE_GITHUB_OWNER=hsinsammy1218
GITHUB_TOKEN=
VERCEL_TOKEN=
# Optional. Omit if the token's default team is correct.
VERCEL_TEAM_ID=
